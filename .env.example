# Variables de entorno de gymflow-frontend.
# Copiar a .env.local y ajustar según el entorno. A diferencia del backend,
# el frontend usa muy pocas — la mayoría de la config vive en next.config.ts
# (headers de seguridad) sin necesidad de env vars.

# URL del backend de Spring Boot. La usan los route handlers de servidor
# (/api/auth/login, /api/auth/register, /api/backend/[...path]) para
# reenviar requests — nunca se expone al navegador.
BACKEND_URL=http://localhost:8080

# Origen esperado para la validación de Origin/Referer en el proxy
# /api/backend/[...path] (defensa adicional contra CSRF en métodos que
# mutan estado). Si no se define, el proxy usa request.nextUrl.origin como
# fallback. Definirla explícitamente en producción (ej:
# https://gymflow-frontend.up.railway.app) evita depender del header Host.
#
# NOTA (notificaciones de vencimiento): este origen debe coincidir con
# EMAIL_CTA_BASE_URL del backend — es la URL a la que apunta el CTA "Renovar
# ahora" de los emails de vencimiento (el backend arma el CTA completo como
# base + /dashboard/suscripciones). No hace falta ninguna variable nueva acá.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- Opcional, solo para tests e2e (Playwright) ---
# URL base contra la que corren los specs de e2e/. Default: localhost:3000.
# BASE_URL=http://localhost:3000
